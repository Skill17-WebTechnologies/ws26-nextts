# Deployed configuration — template.
#
# The entrypoint copies this file over .env on container start whenever the
# environment does not already provide DATABASE_URL, so this is what the
# deployed app runs against. It is written per competitor by Mission Control
# with that competitor's own MySQL database.
#
# Fill in the values before deploying.
DATABASE_URL="mysql://USER:PASSWORD@mysql.nstrim.app:3306/DATABASE"
